# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot (leave empty for no restriction)
ALLOWED_USERS=

# Copilot model to use (default: gpt-4.1)
MODEL=gpt-4.1

# Copilot CLI connection mode:
#   - Leave empty to spawn CLI as a local subprocess (default, recommended for personal use)
#   - Set to host:port to connect to an external headless CLI server (e.g. localhost:4321)
#     Start the server with: copilot --headless --port 4321
COPILOT_CLI_URL=

# Directory for persistent data (default: ./data)
DATA_DIR=./data

# Assistant name used in the system prompt
ASSISTANT_NAME=My Personal Assistant

# YouTube Summary MCP server API keys
YOUTUBE_API_KEY=your_youtube_api_key_here
SUPADATA_API_KEY=your_supadata_api_key_here

# YouTube Summary MCP server configuration
# Set to true if the script runs inside WSL (Windows Subsystem for Linux)
YOUTUBE_SUMMARY_USE_WSL=false
# Path to the youtube-summary dist/index.js (use Linux path if USE_WSL=true)
YOUTUBE_SUMMARY_SCRIPT_PATH=/path/to/youtube-summary/dist/index.js
